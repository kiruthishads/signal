# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── Database ──────────────────────────────────────────────────────────────────
# Use the Supabase Transaction pooler URL (port 6543) for asyncpg
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Found at: Supabase Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
# Create at: github.com/settings/developers → New OAuth App
# Callback URL: http://localhost:3000/auth/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:3000/auth/callback

# ── Gemini ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_CAPABILITY=gemini-3.1-pro-preview
GEMINI_MODEL_RECOMMENDATION=gemini-2.5-flash-preview-05-20

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Admin ─────────────────────────────────────────────────────────────────────
# Leave blank to disable admin endpoints in development
ADMIN_API_KEY=
