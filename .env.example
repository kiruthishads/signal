# ============================================================
# SIGNAL EDU — Root Environment Variables
# Copy to .env and fill in all values before deploying.
# ============================================================

# ── Backend (Railway) ────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false

# Supabase Postgres connection (use Transaction Pooler for serverless)
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase API
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # Settings > API > service_role key
SUPABASE_JWT_SECRET=your-jwt-secret  # Settings > API > JWT Secret

# GitHub OAuth (registered at github.com/settings/applications)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=https://[project-ref].supabase.co/auth/v1/callback

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_CAPABILITY=claude-sonnet-4-5
ANTHROPIC_MODEL_RECOMMENDATION=claude-haiku-4-5-20251001

# The deployed Vercel URL (no trailing slash)
FRONTEND_URL=https://signal-edu.vercel.app

# Rate limiting
DAILY_ANALYSIS_LIMIT=3

# Admin API key (generate a strong random string, e.g. openssl rand -hex 32)
ADMIN_API_KEY=

# ── Frontend (Vercel) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...   # Settings > API > anon key
NEXT_PUBLIC_API_URL=https://signal-backend.up.railway.app/v1
